---
layout: layouts/base.njk
title: Home
description: Recent posts from the technical blog.
---
<section aria-labelledby="recent-posts">
  <header class="page-header">
    <h1 id="recent-posts">Recent posts</h1>
    <p>Notes, experiments, and technical write-ups published with Eleventy.</p>
  </header>

  {% if collections.posts.length %}
    <ul class="post-list">
      {% for post in collections.posts %}
        <li class="post-card">
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          <p class="post-meta"><time datetime="{{ post.date.toISOString() }}">{{ post.date | readableDate }}</time></p>
          {% if post.data.description %}
            <p>{{ post.data.description }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No posts yet.</p>
  {% endif %}
</section>
