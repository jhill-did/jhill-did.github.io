<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ page.url | url | absoluteUrl(site.url) }}">
    <link rel="alternate" href="{{ '/feed.xml' | url | absoluteUrl(site.url) }}" type="application/atom+xml" title="{{ site.title }}">
    <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.title }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | url | absoluteUrl(site.url) }}">
    <meta name="generator" content="Eleventy">
    <link rel="stylesheet" href="/assets/css/site.css">
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="site-title" href="/">{{ site.title }}</a>
        <nav aria-label="Primary">
          <ul class="site-nav">
            {% for item in site.navigation %}
              <li><a href="{{ item.url }}">{{ item.title }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" class="shell">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div class="shell">
        <p>{{ site.description }}</p>
      </div>
    </footer>
  </body>
</html>
