<!doctype html>
<html lang="{{ metadata.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} · {% endif %}{{ metadata.title }}</title>
    <meta name="description" content="{{ description or metadata.description }}">
    <link rel="alternate" href="{{ "/feed/feed.xml" | url | absoluteUrl(metadata.url) }}" type="application/atom+xml" title="{{ metadata.title }}">

    <style>/* This is an arbitrary CSS string added to the bundle */</style>
    <style>{% include "css/index.css" %}</style>
    <style>{% getBundle "css" %}</style>

    <script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>

		<!-- Schibsted Grotesk -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">

  </head>
  <body>
    <a href="#main" id="skip-link" class="visually-hidden">Skip to main content</a>

    <header>
      <a href="{{ "/" | url }}" class="home-link">{{ metadata.title }}</a>

      <nav>
        <h2 class="visually-hidden">Top level navigation menu</h2>
        <ul class="nav">
        {%- for entry in collections.all | eleventyNavigation %}
          <li class="nav-item"><a href="{{ entry.url }}" data-text="{{ entry.title }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
        {%- endfor %}
          <li class="nav-item"><a href="{{ "/feed/feed.xml" | url }}">Feed</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <heading-anchors>
        {{ content | safe }}
      </heading-anchors>
    </main>

    <!-- This page `{{ page.url }}` was built on {% currentBuildDate %} -->
  </body>
</html>
