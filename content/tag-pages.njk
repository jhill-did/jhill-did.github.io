---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - posts
eleventyExcludeFromCollections: true
title: Tagged '{{ tag }}'
permalink: /tags/{{ tag | tagSlug }}/
---
<h1>Tagged “{{ tag }}”</h1>

{% set postslist = collections[tag] %}
{% include "postslist.njk" %}

<p>See <a href="{{ "/tags/" | url }}">all tags</a>.</p>
